{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${eyebrow}",
      "size": "small",
      "weight": "bolder",
      "color": "accent",
      "spacing": "none",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "size": "extraLarge",
      "weight": "bolder",
      "spacing": "small",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${subtitle}",
      "size": "default",
      "isSubtle": true,
      "spacing": "none",
      "wrap": true
    },
    {
      "type": "ColumnSet",
      "spacing": "medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${weekDone}/${weekTarget}",
              "size": "large",
              "weight": "bolder",
              "spacing": "none"
            },
            {
              "type": "TextBlock",
              "text": "This week",
              "size": "small",
              "isSubtle": true,
              "spacing": "none"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${streak}",
              "size": "large",
              "weight": "bolder",
              "spacing": "none"
            },
            {
              "type": "TextBlock",
              "text": "Week streak",
              "size": "small",
              "isSubtle": true,
              "spacing": "none"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "${cta}",
      "verb": "open-today"
    }
  ]
}
